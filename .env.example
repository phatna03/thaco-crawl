APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Supabase / PostgreSQL (ví dụ)
# DB_CONNECTION=pgsql
# DB_HOST=db.xxxxx.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_SSLMODE=require

# AI: OpenAI (mặc định) — AI_DRIVER=openai + OPENAI_API_KEY
AI_DRIVER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=120
AI_HTTP_TIMEOUT=120

# Tiết kiệm token / độ dài output (tùy chọn)
# AI_MAX_INPUT_CHARS=8000
# AI_MAX_OUTPUT_TOKENS=4096
# AI_MAX_TAG_COUNT=5
# AI_SUMMARY_MAX_WORDS=100
# AI_REWRITTEN_MIN_WORDS=250
# AI_RETRY_ATTEMPTS=3
# AI_DEFAULT_WRITING_STYLE="Chuyên nghiệp, súc tích..."

# Google Gemini (tùy chọn, khi AI_DRIVER=gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Crawl / sitemap — cURL trên Windows thường thiếu CA bundle → lỗi SSL.
# Khuyến nghị: tải https://curl.se/ca/cacert.pem rồi đặt đường dẫn đầy đủ, ví dụ:
# CRAWL_CAFILE=D:\php\extras\ssl\cacert.pem
# Chỉ dev tạm: CRAWL_VERIFY_SSL=false (không bật trên production)
CRAWL_VERIFY_SSL=true

# Admin seed (chỉ bật true MỘT LẦN nếu thật sự muốn migration tạo user — khuyến nghị dùng php artisan db:seed)
# FILAMENT_ADMIN_SEED_ON_MIGRATE=false
# TRUSTED_PROXIES=

# Giới hạn số bài import mới / ngày (để trống = không giới hạn)
# DAILY_POST_IMPORT_LIMIT=100

# Tùy chọn: php artisan db:seed
# FILAMENT_ADMIN_NAME="Quản trị"
# FILAMENT_ADMIN_EMAIL=admin@example.com
# FILAMENT_ADMIN_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
